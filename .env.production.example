# Production Environment Variables
# Copy this to .env.production and fill in your actual values
# DO NOT commit .env.production to Git!

# Supabase Configuration
# Get from: https://supabase.com/dashboard → rl-jewels-inventory → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Contact Information (already in code, but can override)
VITE_WHATSAPP_NUMBER=919403891854
VITE_PHONE_NUMBER=+919403891854

# Google Analytics (Optional)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Site URL (Optional - for meta tags)
VITE_SITE_URL=https://your-site.vercel.app

# Admin Email (for magic link)
VITE_ADMIN_EMAIL=lbagade6@gmail.com
